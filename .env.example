# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000 in dev)
PORT="3000"

# MONGODB_URI: MongoDB connection string (e.g., mongodb+srv://... or mongodb://localhost:27017/neurorehab)
# When omitted, the backend utilizes the robust persistent embedded storage engine.
MONGODB_URI=""

# JWT Secrets for short-lived access tokens and secure refresh token rotation
JWT_ACCESS_SECRET="neurorehab_access_token_secret_key_change_in_production_2026"
JWT_REFRESH_SECRET="neurorehab_refresh_token_secret_key_change_in_production_2026"

# CORS client origins
CLIENT_ORIGINS="*"

# Science Skills (PubMed / NCBI E-utilities) polite access
USER_EMAIL="clinician@neurorehab-connect.health"
# Optional NCBI API key for higher rate limits (10 req/s instead of 3 req/s)
# NCBI_API_KEY=""

# Mobile App Firebase Firestore Synchronization Configuration
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0128874261"
VITE_FIREBASE_PROJECT_NUMBER="786614798934"
VITE_FIREBASE_API_KEY="AIzaSyCGmbXP49a16SPMEZn_djnKhLLDLpT6s_8"
VITE_FIREBASE_DATABASE_ID="ai-studio-android-neuroreh-8f127a59-721b-4d7b-8210-a5dec4b3557a"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0128874261.firebaseapp.com"
